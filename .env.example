# GEMINI_API_KEY: Required for direct Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_GATEWAY_API_KEY: Optional Vercel AI Gateway key (starts with vck_...).
# Configure inside Vercel Project Settings -> Environment Variables (never commit real keys).
AI_GATEWAY_API_KEY="MY_VERCEL_AI_GATEWAY_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Robô Duque GPS Maps.
# AI Studio automatically provisions this in user secrets; on Vercel add it under Environment Variables.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY: Optional reCAPTCHA Enterprise site key for Firebase App Check on Google Maps.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# AGENTE SERVIDOR DE VISITAS -> WHATSAPP AUTOMÁTICO (Somente servidor, nunca usar prefixo VITE_)
# Número de destino do administrador no formato internacional (somente dígitos, ex: 5596981153517)
WHATSAPP_ADMIN_PHONE="5596981153517"

# Opção 1 (Mais rápida — 1 minuto): Chave gratuita do CallMeBot para envio automático no WhatsApp
CALLMEBOT_API_KEY=""

# Opção 2 (Oficial Meta WhatsApp Cloud API): Token e Phone Number ID
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Opção 3 (Webhook HTTPS público — Evolution API / Z-API / Make / n8n)
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_SECRET=""
