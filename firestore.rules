    }

    match /business_portal_records/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(recordId) && isSignedIn() && isValidBusinessPortalRecord(incoming()) &&
        incoming().id == recordId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(recordId) && isSignedIn() && isValidBusinessPortalRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isValidId(recordId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /ecclesiastical_portal_records/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(recordId) && isSignedIn() && isValidEcclesiasticalPortalRecord(incoming()) &&
        incoming().id == recordId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(recordId) && isSignedIn() && isValidEcclesiasticalPortalRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isValidId(recordId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /executive_mandates/{mandateId} {
      allow get: if isValidId(mandateId) && isSignedIn() && (existing().assigneeUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.assigneeUid == request.auth.uid);
      allow create: if isValidId(mandateId) && isAdmin() && isValidExecutiveMandate(incoming()) &&
        incoming().id == mandateId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(mandateId) && isSignedIn() && isValidExecutiveMandate(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().assigneeUid == request.auth.uid &&
            existing().status in ['outorgado', 'em_execucao', 'relatorio_enviado'] &&
            incoming().assigneeUid == existing().assigneeUid &&
            incoming().assigneeName == existing().assigneeName &&
            incoming().assigneeRole == existing().assigneeRole &&
            incoming().area == existing().area &&
            incoming().missionTitle == existing().missionTitle &&
            incoming().scopeDescription == existing().scopeDescription &&
            incoming().state == existing().state &&
            incoming().grantedBy == existing().grantedBy &&
            incoming().insertedIntoCatalog == existing().insertedIntoCatalog &&
            incoming().status in ['em_execucao', 'relatorio_enviado'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'city', 'partnerName', 'partnerDiscountPercent', 'partnerStars',
              'executionReport', 'reportSubmittedBy', 'reportSubmittedAt', 'status', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(mandateId) && isAdmin();
    }

    match /duke_events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(eventId) && isSignedIn() && isValidDukeEvent(incoming()) &&
        incoming().id == eventId &&
        incoming().slug == eventId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(eventId) && isSignedIn() && isValidDukeEvent(incoming()) &&
        incoming().id == existing().id &&
        incoming().slug == existing().slug &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().ownerUid == request.auth.uid || isAdmin());
      allow delete: if isValidId(eventId) && isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /app_visit_logs/{visitId} {
      allow get: if isValidId(visitId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(visitId) && isValidAppVisitLog(incoming()) &&
        incoming().id == visitId &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(visitId) && isAdmin();
    }
  }
}
